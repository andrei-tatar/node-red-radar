{
  "name": "@andrei-tatar/node-red-contrib-radar",
  "version": "0.5.0",
  "description": "",
  "scripts": {
    "clean": "rm -rf build",
    "build-api": "tsc -p . && cp src/*.html build/",
    "build-ui": "rm -rf build/browser && npx rollup --config --environment NODE_ENV:production",
    "build": "npm run clean && npm run build-api && npm run build-ui",
    "dev-api": "tsx watch src/local.ts",
    "dev-ui": "npx rollup --config --environment NODE_ENV:development --watch",
    "dev": "concurrently --kill-others \"npm run dev-ui\" \"npm run dev-api\"",
    "pub": "npm run build && npm publish --access=public --registry https://registry.npmjs.org/"
  },
  "keywords": [
    "node-red"
  ],
  "node-red": {
    "version": ">=1.0.0",
    "nodes": {
      "node-radar": "build/node-radar.js"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "mqtt": "^5.14.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rollup": "^4.53.3",
    "rollup-plugin-livereload": "^2.0.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^4.22.1",
    "rxjs": "^7.8.2",
    "transformation-matrix": "^3.1.0",
    "ws": "^8.18.3"
  }
}

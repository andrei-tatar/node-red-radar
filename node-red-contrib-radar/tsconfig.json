{
  "compilerOptions": {
    "noImplicitAny": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "rootDir": "./src",
    "outDir": "./build",
    "skipLibCheck": true
  },
  "include": ["src/"],
  "exclude": ["src/browser"]
}

{
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "target": "es2022",
    "module": "es2022",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,

    "noImplicitAny": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/browser/**/*"]
}
